.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# ─── Streamlit ───────────────────────────────────────────────────────────────
.streamlit/

# ─── Great Expectations ──────────────────────────────────────────────────────
uncommitted/

